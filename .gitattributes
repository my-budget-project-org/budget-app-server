# --- 모든 텍스트 파일 기본 동작 ---
* text=auto

# --- Gradle Wrapper 스크립트 ---
*.bat text eol=crlf
gradlew text eol=lf

# --- 소스 코드 / 리소스 파일 ---
*.kt text eol=lf
*.java text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
Dockerfile text eol=lf

# --- 바이너리 파일 ---
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary